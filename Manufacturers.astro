---
import { getProductsSync, getCategoriesSync } from "../utils/dataReader";
const products = getProductsSync();
import type { Language } from "../utils/i18n";

interface Props {
  lang?: Language;
  ui?: any;
}

const { lang = "tr", ui } = Astro.props;

// Get translations with fallbacks
const sectionTitle = ui?.sections?.brands || "Çalıştığımız Markalar";

const categories = getCategoriesSync();
import { DEFAULT_LANGUAGE } from "../utils/i18n";

// Helper to get localized data
function getCatLoc(cat: any, lang: Language) {
  return cat.i18n[lang] || cat.i18n["en"] || cat.i18n["tr"] || {};
}

import { getBrandImage } from "../utils/brandImages";
import { getProductBrandSlug } from "../utils/brandUtils";

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const searchPath = lang === DEFAULT_LANGUAGE ? "/arama" : `/${lang}/arama`;
const searchUrl = base ? `${base}${searchPath}` : searchPath;

// 1. Identify Root Categories
const rootCategories = Object.values(categories).filter(
  (cat: any) => !cat.parentSlug,
);
const rootSlugs = new Set(rootCategories.map((cat: any) => cat.slug));

// 2. Identify Brand Categories
// A category is a brand if explicit type='brand' OR (legacy fallback) it's Level 2
const brandCategories = Object.values(categories).filter(
  (cat: any) => {
    const isBrand = cat.type === 'brand';
    const isLegacyBrand = !cat.type && cat.parentSlug && rootSlugs.has(cat.parentSlug);
    return (isBrand || isLegacyBrand) && (cat.showOnHome === undefined || cat.showOnHome === true);
  }
);

// 3. Extract unique brand names and images using canonical slugs
const brandsMap = new Map();

brandCategories.forEach((cat: any) => {
  const loc = getCatLoc(cat, lang);
  const name = (loc.name || cat.i18n?.["en"]?.name || cat.i18n?.["tr"]?.name || "").trim();
  const canonicalSlug = getProductBrandSlug(cat.slug);

  // Exclude invalid, empty, or fallback "Other" entries
  if (!canonicalSlug || canonicalSlug.toLowerCase() === "other" || !name) return;
  
  const brandImage = getBrandImage(canonicalSlug, cat.slug);

  if (!brandsMap.has(canonicalSlug)) {
    // Dedup by canonical slug
    brandsMap.set(canonicalSlug, {
      name: name,
      slug: canonicalSlug,
      image: brandImage,
    });
  } else {
    // If brand was already added but has no image, attempt to resolve image from this category
    const existing = brandsMap.get(canonicalSlug);
    if (!existing.image && brandImage) {
      existing.image = brandImage;
    }
  }
});

const brands = Array.from(brandsMap.values()).sort((a, b) =>
  a.name.localeCompare(b.name),
);
---

<section class="manufacturers">
  <div class="container">
    <div class="section-title">
      <h2>{sectionTitle}</h2>
    </div>
    <div class="brand-grid">
      {
        brands.map((brand) => (
          <a
            href={`${searchUrl}?brand=${encodeURIComponent(brand.slug)}`}
            class="brand-item"
          >
            {brand.image && !brand.image.includes("default") ? (
              <img src={brand.image} alt={brand.name} class="brand-image" />
            ) : (
              <span class="brand-name">{brand.name}</span>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .manufacturers {
    padding: 4rem 0;
    background: white;
    border-top: 1px solid #eee;
  }
  .container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .section-title h2 {
    text-align: center;
    margin-bottom: 2rem;
    color: #444;
    font-size: 1.5rem;
  }
  .brand-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }
  .brand-item {
    padding: 1rem 2rem;
    border: 1px solid #eee;
    border-radius: 4px;
    color: #666;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.3s;
    cursor: pointer;
    background: #fcfcfc;
    text-decoration: none;
  }
  .brand-item:hover {
    border-color: #ccc;
    color: #333;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
  }

  @media (max-width: 768px) {
    .manufacturers {
      padding: 3rem 0;
    }
    .brand-grid {
      gap: 0.8rem;
    }
    .brand-item {
      padding: 0.8rem 1.2rem;
      font-size: 0.95rem;
      flex: 1 1 calc(50% - 0.8rem); /* 2 items per row */
      text-align: center;
      min-width: 120px;
      flex-direction: column;
      gap: 0.5rem;
    }
    .brand-image {
      height: 40px;
    }
  }

  .brand-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
  }

  .brand-image {
    height: 50px;
    width: auto;
    object-fit: contain;
    max-width: 100px;
  }
</style>
