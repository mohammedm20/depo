---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProductCard from "../../components/ProductCard.astro";
import AddToCartBtn from "../../components/AddToCartBtn.astro";
import { getCategoriesSync, getProductsSync } from "../../utils/dataReader";
const categories = getCategoriesSync();
const products = getProductsSync();
import { getCategoryImage } from "../../utils/categoryImages";
import {
    getPageData,
    DEFAULT_LANGUAGE,
    type Language,
} from "../../utils/i18n";
import { getProductImage } from "../../utils/productImages";
import { formatUrlSlug } from "../../utils/urlFormatter";
import { getProductBrandSlug, getBrandNameFromSlug } from "../../utils/brandUtils";
import siteData from "../../data/site.json";

interface Props {
    lang: Language;
}

const { lang } = Astro.props;
const { ui, site } = await getPageData(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// Get search query from URL
const searchQuery = Astro.url.searchParams.get("q") || "";

// Identify non-assignable (parent) categories
const parentSlugs = new Set();
Object.values(categories).forEach((cat: any) => {
    if (cat.parentSlug) parentSlugs.add(cat.parentSlug);
});

// Search products (server-side: just return all, client will filter)
function getAllProducts() {
    return Object.entries(products).map(([id, product]) => {
        const prod = product as any;
        return {
            ...prod,
            id,
            title: prod.i18n[lang]?.title || prod.i18n["en"]?.title || prod.i18n["tr"]?.title,
            image: getProductImage(id, prod.image),
        };
    });
}

// Search categories (server-side: just return all, client will filter)
function getAllCategories() {
    return Object.entries(categories)
        .filter(([slug]) => !parentSlugs.has(slug)) // Only show assignable (leaf) categories
        .map(([slug, cat]) => ({
            ...cat,
            slug,
            name: cat.i18n[lang]?.name || cat.i18n["en"]?.name || cat.i18n["tr"]?.name,
            title: cat.i18n[lang]?.title || cat.i18n["en"]?.title || cat.i18n["tr"]?.title,
            description: cat.i18n[lang]?.description || cat.i18n["en"]?.description || cat.i18n["tr"]?.description,
            // Dynamically discover image from folder
            image: getCategoryImage(slug),
        }));
}

// Helpers moved to brandUtils.ts

// Helper: Extract searchable text from dynamic specifications
function getSpecsSearchText(product: any, currentLang: string): string {
    const translations = product.translations || {};
    const allKeysText: string[] = [];
    
    // Get specs from all languages to allow cross-language search
    ['tr', 'en', 'ar'].forEach(l => {
        const keys = translations[l]?.keys || [];
        keys.forEach((spec: { key: string; value: string }) => {
            if (spec.key) allKeysText.push(spec.key);
            if (spec.value) allKeysText.push(spec.value);
        });
    });
    
    return allKeysText.join(' ');
}

// Enhance products with calculated brand slug and specs search text
const searchResults = getAllProducts().map(p => ({
    ...p,
    // OVERRIDE static brand with dynamic category-based brand SLUG
    brand: getProductBrandSlug(p.categorySlug),
    // Stock Status
    inStock: !p.stockStatus || p.stockStatus === 'in_stock',
    stockStatus: p.stockStatus || 'in_stock',
    // Add specs text for search
    specsText: getSpecsSearchText(products[p.id], lang)
}));

const categoryResults = getAllCategories();

// Get unique filter values from products (dynamic detection)
function getFilterOptions(products: any[]) {
    const filters: {
        [key: string]: { values: Map<string, number>; type: string };
    } = {};

    // Define which fields arefilter and their types
    const filterableFields = {
        brand: {
            label: { tr: "Marka", en: "Brand", ar: "العلامة التجارية" },
            type: "checkbox",
        },
        inStock: {
            label: { tr: "Stok Durumu", en: "Availability", ar: "التوفر" },
            type: "boolean",
        },
        categorySlug: {
            label: { tr: "Kategori", en: "Category", ar: "الفئة" },
            type: "checkbox",
        },
    };

    // Pre-populate brands to ensure they show up even with 0 products
    const rootSlugs = new Set(Object.values(categories).filter((cat: any) => !cat.parentSlug).map((c: any) => c.slug));
    const allBrands = Object.values(categories).filter(
        (cat: any) => {
            const isBrand = cat.type === 'brand';
            const isLegacyBrand = !cat.type && cat.parentSlug && rootSlugs.has(cat.parentSlug);
            return (isBrand || isLegacyBrand) && (cat.showOnHome === undefined || cat.showOnHome === true);
        }
    );

    if (!filters["brand"]) {
        filters["brand"] = { values: new Map(), type: "checkbox" };
    }
    
    // Set initial count to 0 for all dynamic brands
    allBrands.forEach((b: any) => {
        const brandName = b.i18n?.["en"]?.name || b.slug;
        const normalizedBrand = brandName.toLowerCase().trim().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
        filters["brand"].values.set(normalizedBrand, 0);
    });

    products.forEach((product) => {
        Object.entries(filterableFields).forEach(([field, config]) => {
            // Check if field exists (brand is now always present due to map above)
            if (product[field] !== undefined && product[field] !== null) {
                if (!filters[field]) {
                    filters[field] = { values: new Map(), type: config.type };
                }

                const value = String(product[field]);
                // For brands, we only increment if it's already in the predefined list, or if we want to add ad-hoc brands too
                // We'll add any brand found in products just in case
                const count = filters[field].values.get(value) || 0;
                filters[field].values.set(value, count + 1);
            }
        });
    });

    // Convert to array format
    return Object.entries(filters).map(([field, filterInfo]) => ({
        field,
        label:
            filterableFields[field as keyof typeof filterableFields]?.label[
                lang
            ] || field,
        type: filterInfo.type,
        options: Array.from(filterInfo.values.entries())
            .map(([value, count]) => ({
                value,
                label:
                    field === "categorySlug"
                        ? categories?.[value]?.i18n?.[lang]?.name || categories?.[value]?.i18n?.["en"]?.name || value
                    : field === "brand"
                        ? getBrandNameFromSlug(value, lang)
                        : value,
                count,
            }))
            .sort((a, b) => b.count - a.count),
    }));
}

// Get price range
function getPriceRange(products: any[]) {
    const prices = products.filter((p) => p.price).map((p) => p.price);
    if (prices.length === 0) return null;
    return {
        min: Math.min(...prices),
        max: Math.max(...prices),
    };
}

const filterOptions = getFilterOptions(searchResults);
const priceRange = getPriceRange(searchResults);

const categoriesText =
    lang === "ar" ? "الفئات" : lang === "en" ? "Categories" : "Kategoriler";
const productsText =
    lang === "ar" ? "المنتجات" : lang === "en" ? "Products" : "Ürünler";

// Translations
const pageTitle = lang === "ar" ? "البحث" : lang === "en" ? "Search" : "Arama";
const homeText = ui?.nav?.home || "Ana Sayfa";
const searchText = lang === "ar" ? "البحث" : lang === "en" ? "Search" : "Arama";
const resultsText =
    lang === "ar" ? "نتيجة" : lang === "en" ? "results found" : "sonuç bulundu";
const noResultsText =
    lang === "ar"
        ? "لم يتم العثور على نتائج"
        : lang === "en"
          ? "No results found"
          : "Sonuç bulunamadı";
const tryAgainText =
    lang === "ar"
        ? "جرب كلمات أخرى"
        : lang === "en"
          ? "Try different keywords"
          : "Farklı anahtar kelimeler deneyin";
const productCodeText = ui?.product?.code || "Ürün Kodu";
const brandText = ui?.product?.brand || "Üretici";
const inStockText = ui?.product?.inStock || "Stokta";
const outOfStockText = ui?.product?.outOfStock || "Stok yok";
const filterPlaceholderText =
    lang === "ar"
        ? "تصفية حسب الاسم أو الرمز"
        : lang === "en"
          ? "Filter by name or code"
          : "İsim veya kod ile filtrele";
const filterText =
    lang === "ar" ? "تصفية" : lang === "en" ? "Filters" : "Filtreler";
const clearFiltersText =
    lang === "ar"
        ? "مسح الفلاتر"
        : lang === "en"
          ? "Clear Filters"
          : "Filtreleri Temizle";
const inStockOnlyText =
    lang === "ar"
        ? "المتوفر فقط"
        : lang === "en"
          ? "In Stock Only"
          : "Sadece Stokta Olanlar";

const itemsPerPageText =
    lang === "ar"
        ? "عناصر في الصفحة:"
        : lang === "en"
          ? "Items per page:"
          : "Sayfa başına ürün:";
const showCategoriesText =
    lang === "ar"
        ? "عرض الفئات"
        : lang === "en"
          ? "Show Categories"
          : "Kategorileri Göster";
const hideCategoriesText =
    lang === "ar"
        ? "إخفاء الفئات"
        : lang === "en"
          ? "Hide Categories"
          : "Kategorileri Gizle";
          
// Calculate explicit home URL based on language
const homeUrl = lang === DEFAULT_LANGUAGE ? `${baseUrl}/` : `${baseUrl}/${lang}`;
const baseUrlWithLang = lang === DEFAULT_LANGUAGE ? baseUrl : `${baseUrl}/${lang}`;
---

<Layout title={`${pageTitle}: ${searchQuery} | ${siteData.shortName}`} lang={lang}>
    <Header lang={lang} ui={ui} />
    <main class="search-page" id="search-page-container">
        <!-- Hero Section -->
        <div class="hero-section">
            <div class="hero-container">
                <nav class="breadcrumb">
                    <a href={homeUrl}>{homeText}</a>
                    <span class="separator">›</span>
                    <span class="current">{searchText}</span>
                </nav>
                <h1>{pageTitle}</h1>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="content-container">
                <div class="page-layout row">
                    <!-- Sidebar Filters -->
                    <aside class="filters-sidebar col-xl-2 col-lg-3" id="filters-sidebar">
                        <div class="sidebar-section">
                            <h3 class="sidebar-title">{filterText}</h3>

                            <!-- Text Filter -->
                            <div class="filter-group">
                                <input
                                    type="text"
                                    id="filter-text"
                                    placeholder={filterPlaceholderText}
                                    class="filter-input"
                                />
                            </div>

                            <!-- In Stock Filter -->
                            <div class="filter-group">
                                <label class="filter-checkbox">
                                    <input
                                        type="checkbox"
                                        id="filter-instock"
                                    />
                                    <span class="checkmark"></span>
                                    <span class="label-text"
                                        >{inStockOnlyText}</span
                                    >
                                </label>
                            </div>

                             <!-- Contact for Price Filter -->
                             <div class="filter-group">
                                <label class="filter-checkbox">
                                    <input
                                        type="checkbox"
                                        id="filter-contact-price"
                                    />
                                    <span class="checkmark"></span>
                                    <span class="label-text">
                                        {lang === "ar" ? "السعر عند الطلب" : lang === "en" ? "Contact for Price" : "Fiyat Sorunuz"}
                                    </span>
                                </label>
                            </div>

                            <!-- Dynamic Brand Filters -->
                            {
                                filterOptions
                                    .filter((f) => f.field === "brand")
                                    .map((filter) => (
                                        <div class="filter-group">
                                            <h4 class="filter-title">
                                                {filter.label}
                                            </h4>
                                            <div class="filter-options">
                                                {filter.options.map(
                                                    (option) => (
                                                        <label class="filter-checkbox">
                                                            <input
                                                                type="checkbox"
                                                                name="brand"
                                                                value={
                                                                    option.value
                                                                }
                                                            />
                                                            <span class="checkmark" />
                                                            <span class="label-text">
                                                                {option.label}
                                                            </span>
                                                            <span class="count">
                                                                ({option.count})
                                                            </span>
                                                        </label>
                                                    ),
                                                )}
                                            </div>
                                        </div>
                                    ))
                            }

                            <!-- Price Range (if available) -->
                            {
                                priceRange && (
                                    <div class="filter-group">
                                        <h4 class="filter-title">
                                            {lang === "ar"
                                                ? "نطاق السعر"
                                                : lang === "en"
                                                  ? "Price Range"
                                                  : "Fiyat Aralığı"}
                                        </h4>
                                        <div class="price-range-inputs">
                                            <div class="price-input-group">
                                                <span class="currency-symbol">€</span>
                                                <input 
                                                    type="number" 
                                                    id="price-min" 
                                                    min="0" 
                                                    max={priceRange.max} 
                                                    placeholder="Min"
                                                    class="price-input"
                                                />
                                            </div>
                                            <span class="price-sep">-</span>
                                            <div class="price-input-group">
                                                <span class="currency-symbol">€</span>
                                                <input 
                                                    type="number" 
                                                    id="price-max" 
                                                    min="0" 
                                                    max={priceRange.max} 
                                                    placeholder="Max"
                                                    class="price-input"
                                                />
                                            </div>
                                            <button id="apply-price-btn" class="apply-price-btn">ok</button>
                                        </div>
                                    </div>
                                )
                            }

                            <button class="clear-filters-btn" id="clear-filters"
                                >{clearFiltersText}</button
                            >
                        </div>
                    </aside>

                    <!-- Results Content -->
                    <div class="results-content col-xl-10 col-lg-9">
                        {
                            categoryResults.length > 0 ||
                            searchResults.length > 0 ? (
                                <>
                                    {categoryResults.length > 0 && (
                                        <div class="results-section">
                                            <h4 class="section-title">
                                                {categoriesText}{" "}
                                                <span class="count-badge">
                                                    {categoryResults.length}
                                                </span>
                                                <button
                                                  id="toggle-categories-btn"
                                                  class="toggle-categories-btn"
                                                  data-show-text={showCategoriesText}
                                                  data-hide-text={hideCategoriesText}
                                                >
                                                    {showCategoriesText}
                                                </button>
                                            </h4>
                                            <div class="categories-grid" id="categories-grid" style="display: none;">
                                                {categoryResults.map((cat) => (
                                                    <a
                                                        href={`${baseUrlWithLang}/${formatUrlSlug(cat.slug)}`}
                                                        class="category-result-card"
                                                        data-slug={cat.slug}
                                                        data-search-text={`${cat.name} ${cat.title} ${cat.description} ${cat.slug}`.toLowerCase()}
                                                    >
                                                        <div class="cat-icon">
                                                        {cat.image && !cat.image.includes("default") ? (
                                                            <img
                                                                src={cat.image}
                                                                alt={cat.name}
                                                            />
                                                        ) : (
                                                            <div style="display: flex; justify-content: center; align-items: center; width: 100%; height: 100%; color: #cbd5e1;">
                                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                                                </svg>
                                                            </div>
                                                        )}
                                                    </div>
                                                        <div class="cat-info">
                                                            <div class="cat-name">
                                                                {cat.name}
                                                            </div>
                                                                {cat.title}
                                                            </div>
                                                        <div class="cat-arrow">
                                                            →
                                                        </div>
                                                    </a>
                                                ))}
                                            </div>
                                        </div>
                                    )}

                                    {searchResults.length > 0 && (
                                        <div class="results-section">
                                            <h4 class="section-title">
                                                {productsText}
                                                <span class="count-badge">
                                                    {searchResults.length}
                                                </span>
                                            </h4>

                                            <!-- Controls -->
                                            <div class="results-controls">
                                                <div class="items-per-page">
                                                    <label for="itemsPerPage">{itemsPerPageText}</label>
                                                    <select id="itemsPerPage">
                                                        <option value="12">12</option>
                                                        <option value="24">24</option>
                                                        <option value="48">48</option>
                                                        <option value="9999">All</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="table-responsive">
                                                <table
                                                    class="table"
                                                    id="results-table"
                                                >
                                                    <thead>
                                                        <tr>
                                                            <th>
                                                                {
                                                                    productCodeText
                                                                }
                                                            </th>
                                                            <th>{brandText}</th>

                                                            <th>
                                                                {lang === "ar" ? "السعر" : lang === "en" ? "Price" : "Fiyat"}
                                                            </th>
                                                            <th style="width: 50px;" />
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {searchResults.map(
                                                            (product) => (
                                                                <tr
                                                                    class="product-row"
                                                                    data-brand={
                                                                        product.brand
                                                                    }
                                                                    data-instock={String(
                                                                        product.inStock,
                                                                    )}
                                                                    data-price={
                                                                        product.price ||
                                                                        0
                                                                    }
                                                                    data-category={
                                                                        product.categorySlug
                                                                    }
                                                                    data-search-text={`${product.id} ${product.title} ${product.brand} ${product.categorySlug} ${categories[product.categorySlug]?.i18n?.[lang]?.name || ""} ${categories[product.categorySlug]?.i18n?.[lang]?.title || ""} ${product.specsText || ""}`.toLowerCase()}
                                                                    data-slug={formatUrlSlug(product.id)}
                                                                >
                                                                    <th>
                                                                        <div style="display: flex; align-items: center; gap: 10px;">
                                                                            {product.image ? (
                                                                                <img 
                                                                                    src={product.image} 
                                                                                    alt={product.id} 
                                                                                    style="width: 40px; height: 40px; object-fit: contain; border: 1px solid #eee; border-radius: 4px; background: #fff;"
                                                                                />
                                                                            ) : (
                                                                                <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: #f8f9fa; border: 1px solid #eee; border-radius: 4px; color: #ccc;">
                                                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                                                        <polyline points="21 15 16 10 5 21"></polyline>
                                                                                    </svg>
                                                                                </div>
                                                                            )}
                                                                            <a
                                                                                href={`${baseUrlWithLang}/${formatUrlSlug(product.id)}`}
                                                                                class="product-id-link"
                                                                            >
                                                                                {
                                                                                    product.id
                                                                                }
                                                                            </a>
                                                                        </div>
                                                                    </th>
                                                                    <td>
                                                                        {
                                                                            getBrandNameFromSlug(product.brand, lang)
                                                                        }
                                                                    </td>

                                                                    <td class="product-price">
                                                                        {product.price === 'contact' ? (
                                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                                                {lang === 'ar' ? "تواصل معنا" : lang === 'en' ? "Contact us" : "İletişime geçin"}
                                                                            </span>
                                                                        ) : product.price ? `€${product.price}` : "-"}
                                                                    </td>
                                                                    <td style="padding: 5px;">
                                                                        <div onclick="event.stopPropagation()">
                                                                            <AddToCartBtn
                                                                                product={{
                                                                                    id: product.id,
                                                                                    title: (product.i18n?.[lang]?.title || product.i18n?.['en']?.title || product.i18n?.[DEFAULT_LANGUAGE]?.title || product.id),
                                                                                    image: getProductImage(product.id),
                                                                                    brand: getBrandNameFromSlug(product.brand, lang),
                                                                                    categorySlug:
                                                                                        product.categorySlug,
                                                                                    price:
                                                                                        product.price ||
                                                                                        0,
                                                                                }}
                                                                                ui={
                                                                                    ui
                                                                                }
                                                                                variant="icon"
                                                                            />
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            ),
                                                        )}
                                                    </tbody>
                                                </table>
                                            </div>
                                        <div class="pagination-container" id="pagination-container" style="display: none;">
                                            <button class="pagination-btn" id="prev-page">←</button>
                                            <div class="pagination-numbers" id="pagination-numbers"></div>
                                            <button class="pagination-btn" id="next-page">→</button>
                                        </div>
                                    </div>
                                    )}
                                    <div
                                        class="no-results"
                                        id="no-results-msg"
                                        style="display: none;"
                                    >
                                        <div class="no-results-icon">🔍</div>
                                        <h3>{noResultsText}</h3>
                                    </div>
                                </>
                            ) : (
                                <div class="no-results">
                                    <div class="no-results-icon">🔍</div>
                                    <h3>
                                        {lang === "ar"
                                            ? "جاري التحميل..."
                                            : lang === "en"
                                              ? "Loading..."
                                              : "Yükleniyor..."}
                                    </h3>
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </main>
    <Footer lang={lang} ui={ui} site={site} />
</Layout>

<script>
    import { SearchEngine, type SearchFilters } from "../../utils/searchEngine";

    document.addEventListener("astro:page-load", async () => {
        // Guard: Only run search logic on the actual search page
        const searchPageContainer = document.getElementById("search-page-container");
        if (!searchPageContainer) return;

        const engine = SearchEngine.getInstance();
        await engine.init();

        // UI Elements
        const filterText = document.getElementById("filter-text") as HTMLInputElement;
        const filterInStock = document.getElementById("filter-instock") as HTMLInputElement;
        const filterContactPrice = document.getElementById("filter-contact-price") as HTMLInputElement;
        const priceMinInput = document.getElementById("price-min") as HTMLInputElement;
        const priceMaxInput = document.getElementById("price-max") as HTMLInputElement;
        const applyPriceBtn = document.getElementById("apply-price-btn");
        const brandCheckboxes = document.querySelectorAll('input[name="brand"]') as NodeListOf<HTMLInputElement>;
        const clearFiltersBtn = document.getElementById("clear-filters");
        
        const productRows = document.querySelectorAll(".product-row") as NodeListOf<HTMLTableRowElement>;
        const catCards = document.querySelectorAll(".category-result-card") as NodeListOf<HTMLAnchorElement>;
        const prodSection = document.getElementById("results-table")?.closest(".results-section") as HTMLElement;
        const catSection = document.querySelector(".categories-grid")?.closest(".results-section") as HTMLElement;
        const noResultsMsg = document.getElementById("no-results-msg");
        const resultCountBadge = prodSection?.querySelector(".count-badge");
        const catCountBadge = catSection?.querySelector(".count-badge");

        // Pagination State
        const itemsPerPageSelect = document.getElementById("itemsPerPage") as HTMLSelectElement;
        const paginationContainer = document.getElementById("pagination-container");
        const prevPageBtn = document.getElementById("prev-page");
        const nextPageBtn = document.getElementById("next-page");
        const paginationNumbers = document.getElementById("pagination-numbers");

        let currentPage = 1;
        let pageSize = parseInt(itemsPerPageSelect?.value || "12");
        let currentVisibleRows: HTMLTableRowElement[] = [];

        function renderPagination() {
            if (!paginationContainer || !paginationNumbers) return;
            const totalPages = Math.ceil(currentVisibleRows.length / pageSize);
            
            if (totalPages <= 1) {
                paginationContainer.style.display = "none";
                return;
            }
            paginationContainer.style.display = "flex";
            paginationNumbers.innerHTML = "";

            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, startPage + 4);

            for (let i = startPage; i <= endPage; i++) {
                const btn = document.createElement("button");
                btn.className = `pagination-number ${i === currentPage ? "active" : ""}`;
                btn.textContent = String(i);
                btn.onclick = () => {
                    currentPage = i;
                    updateRowVisibility();
                };
                paginationNumbers.appendChild(btn);
            }

            if (prevPageBtn) (prevPageBtn as HTMLButtonElement).disabled = currentPage === 1;
            if (nextPageBtn) (nextPageBtn as HTMLButtonElement).disabled = currentPage === totalPages;
        }

        function updateRowVisibility() {
            productRows.forEach(row => row.style.display = "none");
            const start = (currentPage - 1) * pageSize;
            const end = start + pageSize;
            currentVisibleRows.slice(start, end).forEach(row => row.style.display = "");
            renderPagination();
        }

        function applyFilters(skipURLUpdate = false) {
            if (!engine.getIsLoaded()) return;
            const searchPageContainer = document.getElementById("search-page-container");
            if (!searchPageContainer) return;

            const filters: SearchFilters = {
                q: filterText?.value || "",
                brand: Array.from(brandCheckboxes).filter(cb => cb.checked).map(cb => cb.value),
                inStock: filterInStock?.checked || false,
                contactPrice: filterContactPrice?.checked || false,
                minPrice: parseFloat(priceMinInput?.value) || 0,
                maxPrice: parseFloat(priceMaxInput?.value) || Infinity
            };

            const results = engine.search(filters);
            const visibleProductIds = new Set(results.products.map(p => p.id));
            const visibleCategoryIds = new Set(results.categories.map(c => c.id));

            // Update Product Rows
            currentVisibleRows = [];
            productRows.forEach(row => {
                const idElement = row.querySelector('.product-id-link');
                const id = (idElement?.textContent || "").trim();
                const isVisible = visibleProductIds.has(id);
                if (isVisible) currentVisibleRows.push(row);
            });

            // Update Category Cards
            catCards.forEach(card => {
                const id = card.dataset.slug || "";
                card.style.display = visibleCategoryIds.has(id) ? "" : "none";
            });

            // Update Counts & Visibility
            if (resultCountBadge) resultCountBadge.textContent = String(currentVisibleRows.length);
            if (catCountBadge) catCountBadge.textContent = String(results.categories.length);
            
            if (prodSection) prodSection.style.display = currentVisibleRows.length > 0 ? "" : "none";
            if (catSection) catSection.style.display = results.categories.length > 0 ? "" : "none";
            if (noResultsMsg) noResultsMsg.style.display = (currentVisibleRows.length === 0 && results.categories.length === 0) ? "block" : "none";

            // Update Facets
            const facetCounts = engine.getFacetedCounts(filters);
            brandCheckboxes.forEach(cb => {
                const countSpan = cb.parentElement?.querySelector('.count');
                if (countSpan) {
                    const count = facetCounts[cb.value] || 0;
                    countSpan.textContent = `(${count})`;
                    cb.parentElement!.style.opacity = count === 0 ? "0.5" : "1";
                }
            });

            // Update URL only if it changed and preserve history state
            const url = new URL(window.location.href);
            Object.entries(filters).forEach(([key, val]) => {
                if (Array.isArray(val)) {
                    if (val.length > 0) url.searchParams.set(key, val.join(","));
                    else url.searchParams.delete(key);
                } else if (typeof val === 'boolean') {
                    if (val) url.searchParams.set(key, "true");
                    else url.searchParams.delete(key);
                } else if (typeof val === 'number') {
                    if (val > 0 && val < Infinity) url.searchParams.set(key, String(val));
                    else if (val === Infinity) url.searchParams.delete(key);
                    else url.searchParams.delete(key);
                }
            });
            
            const targetUrl = url.toString();
            if (!skipURLUpdate && window.location.href !== targetUrl) {
                window.history.replaceState(window.history.state, "", targetUrl);
            }

            // Sync row navigation with new standardized behavior
            productRows.forEach(row => {
                if (!row.dataset.listenerAdded) {
                    row.addEventListener('click', () => {
                        const slug = row.getAttribute('data-slug');
                        if (slug) {
                             // Use baseUrlWithLang which is defined in the Astro frontmatter
                             // We'll need to pass it to the client side or construct it
                             const finalUrl = `${baseUrlWithLang}/${slug}`;
                             window.location.href = finalUrl;
                        }
                    });
                    row.dataset.listenerAdded = "true";
                }
            });

            currentPage = 1;
            updateRowVisibility();
        }

        function loadFromURL() {
            const params = new URLSearchParams(window.location.search);
            if (filterText) filterText.value = params.get("q") || "";
            if (filterInStock) filterInStock.checked = params.get("inStock") === "true";
            if (filterContactPrice) filterContactPrice.checked = params.get("contactPrice") === "true";
            if (priceMinInput) priceMinInput.value = params.get("minPrice") || "";
            if (priceMaxInput) priceMaxInput.value = params.get("maxPrice") || "";
            
            const brands = (params.get("brand")?.split(",") || []).map(b => b.toLowerCase().trim()).filter(Boolean);
            brandCheckboxes.forEach(cb => {
                cb.checked = brands.includes(cb.value.toLowerCase().trim());
            });
            
            applyFilters(true);
        }

        // Event Listeners
        filterText?.addEventListener("input", applyFilters);
        filterInStock?.addEventListener("change", applyFilters);
        filterContactPrice?.addEventListener("change", applyFilters);
        applyPriceBtn?.addEventListener("click", applyFilters);
        brandCheckboxes.forEach(cb => cb.addEventListener("change", applyFilters));

        itemsPerPageSelect?.addEventListener("change", () => {
            pageSize = parseInt(itemsPerPageSelect.value);
            currentPage = 1;
            updateRowVisibility();
        });

        prevPageBtn?.addEventListener("click", () => { if (currentPage > 1) { currentPage--; updateRowVisibility(); } });
        nextPageBtn?.addEventListener("click", () => { 
            const totalPages = Math.ceil(currentVisibleRows.length / pageSize);
            if (currentPage < totalPages) { currentPage++; updateRowVisibility(); } 
        });

        clearFiltersBtn?.addEventListener("click", () => {
            if (filterText) filterText.value = "";
            if (filterInStock) filterInStock.checked = false;
            if (filterContactPrice) filterContactPrice.checked = false;
            if (priceMinInput) priceMinInput.value = "";
            if (priceMaxInput) priceMaxInput.value = "";
            brandCheckboxes.forEach(cb => cb.checked = false);
            applyFilters();
        });

        document.addEventListener('search-query-changed', (e: CustomEvent) => {
            if (filterText) {
                filterText.value = e.detail;
                applyFilters();
                prodSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });

        // Toggle Categories
        const toggleBtn = document.getElementById("toggle-categories-btn");
        const catGrid = document.getElementById("categories-grid");
        toggleBtn?.addEventListener("click", () => {
            if (catGrid) {
                const isHidden = catGrid.style.display === "none";
                catGrid.style.display = isHidden ? "grid" : "none";
                toggleBtn.textContent = isHidden ? (toggleBtn.dataset.hideText || "") : (toggleBtn.dataset.showText || "");
            }
        });

        loadFromURL();
    });
</script>

